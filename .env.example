# ───── App ─────
ENVIRONMENT=development  # "development" ou "production"

# ───── Autenticação ─────
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ───── Banco ─────
# Opção 1 — SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///database.db

# Opção 2 — PostgreSQL (prod): deixe DATABASE_URL vazio e preencha abaixo.
# DATABASE_URL=
# DB_USER=projeto_autismo
# DB_PASSWORD=projeto_autismo
# DB_NAME=projeto_autismo
# DB_HOST=localhost
# DB_PORT=5432
